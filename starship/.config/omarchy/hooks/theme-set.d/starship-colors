#!/bin/bash
# Rewrites ~/.config/starship.toml in place using the current Omarchy
# theme's colors.toml, from the template at ~/.dotfiles/starship/starship.toml.tpl.
# Installed via `omarchy hook install theme-set`; runs after every theme change.
set -euo pipefail

TEMPLATE="$HOME/.dotfiles/starship/starship.toml.tpl"
COLORS_FILE="$HOME/.local/state/omarchy/current/theme/colors.toml"
TARGET="$HOME/.config/starship.toml"

[ -f "$TEMPLATE" ] || exit 0
[ -f "$COLORS_FILE" ] || exit 0

content=$(cat "$TEMPLATE")

while IFS='=' read -r key value; do
  key="${key// /}"
  value="${value//\"/}"
  value="${value// /}"
  [ -z "$key" ] && continue
  content="${content//\{\{ $key \}\}/$value}"
done < <(grep -E '^[a-z_]+ = "#' "$COLORS_FILE")

printf '%s\n' "$content" > "$TARGET"
